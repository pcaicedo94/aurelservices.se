# Aurel Städ & Allservice AB — redirecciones 301 de las rutas en inglés a las
# rutas en sueco (renombrado de 2026-09-29).
#
# Este archivo tiene que acabar en la RAÍZ del sitio publicado (el mismo
# directorio que index.html), no dentro de una subcarpeta. Está en `public/`
# porque Next copia ese directorio tal cual a la raíz de la salida.
#
# Se usa RedirectMatch con `^...` y `/?$` en lugar de `Redirect`, porque
# `Redirect` hace coincidencia por PREFIJO: `Redirect 301 /kontakt` también
# capturaría `/kontakt-oss` o `/kontakt/algo`. Cada regla de abajo casa
# exactamente la ruta vieja, con y sin barra final, y nada más.
#
# Ninguna ruta nueva aparece como origen: no hay bucles de redirección.
# Las rutas nuevas (/tjanster/..., /foretag/..., /om-oss, /kontakt, /karriar,
# /vanliga-fragor, /integritetspolicy, /allmanna-villkor) se sirven directamente.
#
# El sitio se publica como export estático con trailingSlash, así que cada
# página es una carpeta con su index.html y la URL canónica termina en barra.
# Por eso los destinos se escriben CON barra final: sin ella mod_dir añadiría
# un segundo 301 y cada enlace antiguo costaría dos saltos.

<IfModule mod_alias.c>

  # --- Tjänster för privatpersoner (inkl. moms, efter RUT) ------------------
  RedirectMatch 301 ^/homecleaning/?$            /tjanster/hemstadning/
  RedirectMatch 301 ^/deepcleaning/?$            /tjanster/storstadning/
  RedirectMatch 301 ^/movecleaning/?$            /tjanster/flyttstadning/
  RedirectMatch 301 ^/windowcleaning/?$          /tjanster/fonsterputs/
  RedirectMatch 301 ^/carpetwashing/?$           /tjanster/mattvatt/
  RedirectMatch 301 ^/gardening/?$               /tjanster/tradgardsskotsel/
  RedirectMatch 301 ^/movinghelp/?$              /tjanster/flytthjalp/
  RedirectMatch 301 ^/snowremoval/?$             /tjanster/snorojning/
  RedirectMatch 301 ^/private-services/?$        /tjanster/

  # --- Tjänster för företag och BRF (exkl. moms, alltid offert) -------------
  # Ojo: /movecleaningbusiness y /windowcleaningbusiness van a las páginas de
  # EMPRESA (/foretag/...), no a las de particular con el mismo nombre sueco.
  RedirectMatch 301 ^/officecleaning/?$          /foretag/kontorsstadning/
  RedirectMatch 301 ^/staircleaning/?$           /foretag/trappstadning/
  RedirectMatch 301 ^/containercleaning/?$       /foretag/bodstadning/
  RedirectMatch 301 ^/floorcare/?$               /foretag/golvvard/
  RedirectMatch 301 ^/movecleaningbusiness/?$    /foretag/flyttstadning/
  RedirectMatch 301 ^/windowcleaningbusiness/?$  /foretag/fonsterputs/
  RedirectMatch 301 ^/construction/?$            /foretag/byggtjanster/
  RedirectMatch 301 ^/services/?$                /foretag/

  # --- Sidor om företaget och systemsidor ----------------------------------
  RedirectMatch 301 ^/about-us/?$                /om-oss/
  RedirectMatch 301 ^/contact/?$                 /kontakt/
  RedirectMatch 301 ^/careers/?$                 /karriar/
  RedirectMatch 301 ^/faq/?$                     /vanliga-fragor/
  RedirectMatch 301 ^/privacy-policy/?$          /integritetspolicy/
  RedirectMatch 301 ^/terms-condition/?$         /allmanna-villkor/

</IfModule>

# --- API en PHP (Simply.com) -----------------------------------------------
# En producción no hay Node, así que pages/api/booking.js y pages/api/contact.js
# dejan de existir y los sustituyen php/api/booking.php y php/api/contact.php.
# Estas reglas conservan las MISMAS URLs que ya pide el JavaScript del
# navegador (lib/booking/useBookingSubmit.js, components/Contact/ContactForm.js
# y components/Common/QuoteModal.js), así que no cambia ni una línea de front.
#
# Por qué no chocan con las 301 de arriba:
#   - ninguna de esas 23 rutas antiguas empieza por /api/, así que no hay
#     solape posible;
#   - mod_alias (RedirectMatch) actúa en la fase de traducción del nombre y
#     mod_rewrite dentro de un .htaccess en la de fixup, es decir DESPUÉS: las
#     301 conservan su prioridad y su orden pase lo que pase aquí abajo.
#
# Por qué no hay bucle: la sustitución es RELATIVA (`api/booking.php`, sin
# barra inicial), de modo que Apache resuelve el fichero directamente sin
# reiniciar el motor de reescritura. Además la condición descarta de entrada
# cualquier petición que ya termine en .php.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{REQUEST_URI} !\.php$
  RewriteRule ^api/booking/?$           api/booking.php   [L,QSA]

  RewriteCond %{REQUEST_URI} !\.php$
  RewriteRule ^api/contact/?$           api/contact.php   [L,QSA]

  # Feed iCalendar de las reservas. La URL a la que se suscribe el móvil es
  # /api/calendar.ics?token=...; se acepta también /api/calendar. Sin el token
  # correcto el endpoint responde 404 (ver php/api/calendar.php).
  RewriteCond %{REQUEST_URI} !\.php$
  RewriteRule ^api/calendar(\.ics)?/?$  api/calendar.php  [L,QSA]
</IfModule>

# Las credenciales viven FUERA de la raíz web (~/aurel-app/config/config.php,
# ver php/README.md). Por si algún despliegue copia de más, se niega el acceso
# a cualquier cosa que las contenga.
<IfModule mod_authz_core.c>
  <FilesMatch "^(config\.php|composer\.(json|lock)|\.env.*)$">
    Require all denied
  </FilesMatch>
</IfModule>

# Página de error del export estático. Next deja 404.html en la raíz, pero
# Apache no la usa si no se le dice.
ErrorDocument 404 /404.html

# Apache 2.4 solo bloquea .ht* por su cuenta. El despliegue deja además un
# manifiesto .aurel-deploy-manifest.json en la raíz, que no debe ser público.
<IfModule mod_authz_core.c>
  <FilesMatch "^\.">
    Require all denied
  </FilesMatch>
</IfModule>
